# KadiRail AI - Environment Configuration
# AMD Developer Hackathon 2026

# === LLM Service (vLLM on AMD Developer Cloud) ===
# Replace <YOUR_VM_IP> with your AMD Developer Cloud instance IP
LLM_BASE_URL=http://<YOUR_VM_IP>:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2-7B-Instruct
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120

# === Optional: Authentication ===
# Set to "true" to enable login page (disabled by default for hackathon demo)
ENABLE_AUTH=false
